var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 1..: z;
constraint 31 = a + b + c;
constraint 28 = c + d;
constraint 25 = a + d + e;
constraint 0 = b + e;
constraint 11 = b + d;
constraint 25 = a + d;
constraint 42 = a + c + d;
constraint z = a + b + c + d + e;
solve minimize z;
output "\(z)";