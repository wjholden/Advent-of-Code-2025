var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 1..: z;
constraint 35 = c + g;
constraint 149 = b + c + d + h;
constraint 194 = c + d + e + f + g + h;
constraint 51 = a + b + c + e + h;
constraint 68 = a + b + c + e + g;
constraint 54 = a + b + f + g + h;
