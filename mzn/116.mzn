var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 1..: z;
constraint 25 = a + b;
constraint 25 = c + d + e;
constraint 33 = a + d + e;
constraint 42 = a + b + c + e;
constraint 38 = b + d + e;
constraint 33 = a + b + d;
constraint z = a + b + c + d + e;
solve minimize z;
output "\(z)";