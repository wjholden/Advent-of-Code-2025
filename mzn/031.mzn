var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 0..: i;
var 0..: j;
var 1..: z;
constraint 8 = a;
constraint 30 = a + d + g + h;
constraint 78 = a + b + d + e + g + i + j;
constraint 49 = b + f + h + j;
constraint 26 = a + d + e + h;
constraint 50 = a + b + d + e + f + h;
constraint 64 = a + c + d + g + j;
constraint 44 = c + h + j;
constraint z = a + b + c + d + e + f + g + h + i + j;
solve minimize z;
output "\(z)";