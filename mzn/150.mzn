var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 1..: z;
constraint 22 = c + f;
constraint 4 = b + e;
constraint 35 = a + b + c + f;
constraint 40 = a + c + d + f;
constraint 20 = a + b + d;
constraint 24 = a + e + f;
constraint 18 = c + d;
constraint z = a + b + c + d + e + f;
solve minimize z;
output "\(z)";