var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 0..: i;
var 1..: z;
constraint 65 = a + b + d + e + g;
constraint 47 = a + d + e + f + h;
constraint 71 = a + b + c + d + e + f + h;
constraint 49 = a + b + c + d + h;
constraint 41 = a + c + d;
constraint 26 = a + c + f;
constraint 24 = a + d;
