var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 1..: z;
constraint 15 = a + b + f + g;
constraint 26 = a + d + e + g;
constraint 26 = a + c + f + g;
constraint 28 = a + b + c + d + h;
constraint 20 = b + c + d;
constraint 13 = a + f + g;
constraint 27 = a + d + e + f + h;
constraint 21 = c + d + f;
constraint 18 = a + b + d + f + h;
constraint 35 = a + b + c + d + f + g + h;
constraint z = a + b + c + d + e + f + g + h;
solve minimize z;
output "\(z)";