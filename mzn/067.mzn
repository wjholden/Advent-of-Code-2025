var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 1..: z;
constraint 70 = a + b + c + d + e + f + g;
constraint 24 = b + d + f;
constraint 32 = a + b + e;
constraint 51 = b + d + e + h;
constraint 39 = b + e + h;
