var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 1..: z;
constraint 34 = a + c + e + f;
constraint 41 = a + b + d + f + g;
constraint 19 = c + e;
