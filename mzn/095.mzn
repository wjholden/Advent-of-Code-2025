var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 1..: z;
constraint 40 = a + c + d + f;
constraint 29 = a + c + e;
constraint 44 = a + b + c + f;
constraint 21 = b + c;
constraint 41 = a + b + c + d + e;
constraint 22 = a + b + d;
constraint z = a + b + c + d + e + f;
solve minimize z;
output "\(z)";