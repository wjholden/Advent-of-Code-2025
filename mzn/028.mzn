var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 1..: z;
constraint 21 = b + d + g;
constraint 33 = a + d + e + g;
constraint 46 = a + b + c + d + e + h;
constraint 20 = a + b + e + f;
