var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 1..: z;
constraint 32 = a + d + f + g;
constraint 25 = a + c + f;
constraint 15 = a + b + c;
constraint 40 = b + c + e + f + g;
constraint 23 = a + b + c + g;
constraint 28 = a + f + g;
constraint 23 = a + b + c + g;
constraint 30 = b + c + d + e + g;
constraint 27 = b + c + d + f;
constraint z = a + b + c + d + e + f + g;
solve minimize z;
output "\(z)";