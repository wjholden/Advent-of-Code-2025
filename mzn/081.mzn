var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 1..: z;
constraint 14 = a + c;
constraint 38 = b + c + e;
constraint 59 = a + b + c + d + g;
constraint 36 = c + d + e;
constraint 60 = d + e + f + g;
constraint z = a + b + c + d + e + f + g;
solve minimize z;
output "\(z)";