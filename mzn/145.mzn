var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 1..: z;
constraint 4 = d;
constraint 41 = c + e + f;
constraint 40 = c + d + e;
constraint 34 = b + e;
constraint 20 = a;
constraint 19 = b + f;
constraint 74 = a + b + c + d + e;
constraint 29 = d + e + f;
constraint z = a + b + c + d + e + f;
solve minimize z;
output "\(z)";