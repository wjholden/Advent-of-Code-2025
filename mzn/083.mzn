var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 1..: z;
constraint 14 = b + f;
constraint 2 = a + d + e;
constraint 37 = a + c + e + g;
constraint 16 = a + d + f + h;
constraint 32 = a + e + g + h;
constraint 49 = c + e + g + h;
constraint z = a + b + c + d + e + f + g + h;
solve minimize z;
output "\(z)";