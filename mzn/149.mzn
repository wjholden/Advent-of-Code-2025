var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 1..: z;
constraint 165 = a + c + e + f + g + h;
constraint 152 = a + b + g + h;
constraint 169 = a + b + c + e + h;
constraint 161 = a + c + e + f + h;
constraint 128 = a + e;
constraint 144 = a + e + f + h;
constraint 50 = c + d + e + g + h;
constraint 72 = b + c + d + e + f + h;
constraint z = a + b + c + d + e + f + g + h;
solve minimize z;
output "\(z)";