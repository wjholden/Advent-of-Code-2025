var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 1..: z;
constraint 64 = c + d + e + f + g;
constraint 44 = a + c + e + g;
constraint 228 = a + b + d + e + f;
