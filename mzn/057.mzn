var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 0..: h;
var 0..: i;
var 1..: z;
constraint 40 = c + e + f + g + i;
constraint 26 = a + c + d + g;
constraint 32 = h + i;
constraint 18 = d + h;
constraint 38 = d + f + h + i;
