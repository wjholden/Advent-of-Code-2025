var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 1..: z;
constraint 38 = a + c;
constraint 47 = a + c + e + g;
constraint 58 = a + c + e + f;
constraint 82 = b + c + d + f + g;
constraint 40 = c + e + f;
constraint 60 = a + b + c + e;
constraint 38 = a + e + f;
constraint 75 = a + c + d + e + f;
constraint z = a + b + c + d + e + f + g;
solve minimize z;
output "\(z)";