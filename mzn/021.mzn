var 0..: a;
var 0..: b;
var 0..: c;
var 0..: d;
var 0..: e;
var 0..: f;
var 0..: g;
var 1..: z;
constraint 55 = a + c + d + e;
constraint 49 = a + b + e + f;
constraint 27 = b + g;
constraint 13 = a;
constraint 41 = c + f + g;
constraint z = a + b + c + d + e + f + g;
solve minimize z;
output "\(z)";